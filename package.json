{
  "name": "@asciidev/eve-box",
  "version": "0.1.0",
  "description": "Eve sandbox backend for Ascii Box.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/examples/eve",
    "README.md",
    "docs/eve-box-backend.md",
    "docs/release.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:real-box": "npm run build && node dist/test/real-box-smoke.js",
    "demo:real-e2e": "npm run build && node dist/scripts/real-e2e-demo.js",
    "proof:interactive": "npm run build && node dist/scripts/interactive-proof-server.js",
    "test:eve-box": "npm run build && node --test dist/test/eve-box-backend.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "eve": "^0.11.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "eve": "^0.11.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
